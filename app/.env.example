# API keys for the providers haiku.rag.yaml uses (none for Ollama)
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# Optional: release of the published images, the same for the backend, the
# frontend and the ingester. The compose file defaults to its own release.
# HAIKU_RAG_VERSION=

# Host directory of the configuration, mounted at /app/config. It holds
# haiku.rag.yaml and the databases/ directory of fragments.
CONFIG_DIR=./config

# Host directory of the LanceDB databases, mounted at /data where
# haiku.rag.yaml places them
DATA_DIR=./data

# Optional: Ollama base URL (if using local models)
# Use host.docker.internal to reach Ollama running on the host machine
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Folder of documents the ingester ingests, mounted at /docs
DOCS_VOLUME=./docs

# Bearer token of the ingester's API, which the frontend sends for you
INGESTER_TOKEN=change-me

# Optional: URL prefix of the frontend under docker-compose.dev.yml, such as
# /rag. The published frontend image serves at the root.
# BASE_PATH=

# Optional: Logfire for observability
LOGFIRE_TOKEN=
