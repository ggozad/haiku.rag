# haiku.rag configuration for the chat app
# Copy to haiku.rag.yaml and customize as needed

# The databases. The compose files mount DATA_DIR (default ./data) at /data,
# so each database is a directory under /data.
lancedb:
  databases:
    haiku.rag: /data/haiku.rag.lancedb

# Each *.yaml in config/databases adds lancedb.databases and
# ingester.databases entries.
databases_include: databases

# QA model configuration
qa:
  model:
    provider: ollama
    name: gpt-oss
    # For Anthropic:
    # provider: anthropic
    # name: claude-sonnet-4-20250514
    # For OpenAI:
    # provider: openai
    # name: gpt-4o

# Embedding configuration
embeddings:
  model:
    provider: ollama
    name: qwen3-embedding:4b
    vector_dim: 2560
    # For OpenAI:
    # provider: openai
    # name: text-embedding-3-small
    # vector_dim: 1536

# Optional reranking
# reranking:
#   model:
#     provider: cohere
#     name: rerank-v3.5

# Search settings
search:
  limit: 5

# Documents convert on the docling-serve service of the compose files.
processing:
  converter: docling-serve
  chunker: docling-serve

# Provider settings
providers:
  docling_serve:
    base_url: http://docling-serve:5001
  ollama:
    # Use host.docker.internal to reach Ollama running on the host machine
    base_url: http://host.docker.internal:11434

# The ingester service ingests the documents mounted at /docs into haiku.rag.
# Its API requires INGESTER_TOKEN from .env as a bearer token, and the frontend
# adds it to every ingester request.
ingester:
  queue:
    path: /queue/ingester.db
  api:
    auth_token: ${INGESTER_TOKEN}
  databases:
    haiku.rag:
      sources:
        - type: fs
          id: docs
          root: /docs
